import { useCallback, useEffect, useState } from 'react'
import './App.css'
import TransactionPanel from './TransactionPanel'
import WalletPanel from './WalletPanel'
import ComputeYieldPanel from './ComputeYieldPanel'


import RevenuePanel from './RevenuePanel'
const API_BASE = (import.meta.env.VITE_API_BASE_URL || 'http://localhost:4000').replace(/\/+$/, '')

type ApiState<T> = {
  data: T | null
  loading: boolean
  error: string | null
}

type Offer = {
  id?: string | number
  externalAssetId?: string | number
  gpuName?: string | null
  hourlyPriceUsd?: number | null
  numGpus?: number | null
  gpuCount?: number | null
  [key: string]: unknown
}

async function request<T>(path: string): Promise<T> {
  const response = await fetch(`${API_BASE}${path}`, {
    headers: { Accept: 'application/json' },
  })
  if (!response.ok) {
    throw new Error(`Request failed (${response.status})`)
  }
  return response.json() as Promise<T>
}

function useApi<T>(path: string, refreshKey: number) {
  const [state, setState] = useState<ApiState<T>>({
    data: null,
    loading: true,
    error: null,
  })

  const load = useCallback(async () => {
    setState((previous) => ({ ...previous, loading: true, error: null }))
    try {
      const data = await request<T>(path)
      setState({ data, loading: false, error: null })
    } catch (error) {
      setState({
        data: null,
        loading: false,
        error: error instanceof Error ? error.message : 'Unable to load data',
      })
    }
  }, [path])

  useEffect(() => {
    void load()
    const timer = window.setInterval(() => void load(), 60000)
    return () => window.clearInterval(timer)
  }, [load, refreshKey])

  return state
}

function shortAddress(value: unknown) {
  if (typeof value !== 'string' || value.length < 12) return 'Not available'
  return `${value.slice(0, 6)}…${value.slice(-4)}`
}

function formatNumber(value: unknown) {
  const number = Number(value)
  return Number.isFinite(number) ? number.toLocaleString() : '—'
}

function formatPrice(value: unknown) {
  if (value === null || value === undefined || value === '') return 'Price unavailable'
  const number = Number(value)
  return Number.isFinite(number)
    ? `$${number.toFixed(3)} / hr`
    : 'Price unavailable'
}

function StatusPill({ state }: { state: 'ok' | 'bad' | 'pending' }) {
  const label = state === 'ok' ? 'Operational' : state === 'bad' ? 'Unavailable' : 'Checking'
  return <span className={`status-pill ${state}`}><span />{label}</span>
}

function App() {
  const [activeWorkspace, setActiveWorkspace] = useState<'overview' | 'token' | 'revenue'>('overview')
  const [refreshKey, setRefreshKey] = useState(0)
  const [search, setSearch] = useState('')
  const [marketSource, setMarketSource] = useState<'live' | 'saved'>('live')

  const chain = useApi<Record<string, unknown>>('/api/v1/chain/status', refreshKey)
  const revenue = useApi<Record<string, unknown>>('/api/v1/revenue/status', refreshKey)
  const offers = useApi<{ offers?: Offer[]; count?: number }>('/api/v1/providers/vast/offers?limit=12', refreshKey)
  const persistedOffers = useApi<{
    offers?: Offer[]
    count?: number
    source?: string
  }>('/api/v1/providers/vast/persisted-offers?limit=12', refreshKey)

  const selectedOffers = marketSource === 'live' ? offers : persistedOffers
  const offerList = Array.isArray(selectedOffers.data?.offers)
    ? selectedOffers.data.offers
    : []
  const visibleOffers = offerList.filter((offer) =>
    String(offer.gpuName ?? offer.name ?? 'GPU offer')
      .toLowerCase()
      .includes(search.toLowerCase()),
  )

  const chainConnected = chain.data?.connected === true
  const revenueReady = Boolean(revenue.data?.address) && !revenue.data?.paused
  const providerReady = offers.data !== null && !offers.error

  return (
    <main className="app-shell">
      <aside className="sidebar">
        <a className="brand" href="#overview" aria-label="Compute Yield home">
          <span className="brand-mark"><span /><span /><span /></span>
          <span>compute<span className="brand-accent">yield</span></span>
        </a>

        <div className="workspace-label">WORKSPACE</div>
        <nav className="side-nav">
          <a className={`nav-link ${activeWorkspace === 'overview' ? 'active' : ''}`} href="#overview" onClick={(event) => { event.preventDefault(); setActiveWorkspace('overview') }}><span>◫</span> Overview</a>
          <a className="nav-link" href="#marketplace" onClick={(event) => { event.preventDefault(); setActiveWorkspace('overview'); document.getElementById('marketplace')?.scrollIntoView({ behavior: 'smooth' }) }}><span>▦</span> Compute marketplace</a>
          <a className={`nav-link ${activeWorkspace === 'revenue' ? 'active' : ''}`} href="#revenue-workspace" onClick={(event) => { event.preventDefault(); setActiveWorkspace('revenue') }}><span>↗</span> Revenue sharing</a>
          <a className={`nav-link ${activeWorkspace === 'token' ? 'active' : ''}`} href="#token-governance" onClick={(event) => { event.preventDefault(); setActiveWorkspace('token') }}><span>◇</span> Token &amp; Governance</a>
        </nav>

        <div className="sidebar-bottom">
          <div className="network-card">
            <span className="network-dot" />
            <div><strong>Monad Testnet</strong><small>Chain ID 10143</small></div>
          </div>
          <p className="sidebar-note">Prototype environment<br />Testnet assets have no mainnet value.</p>
        </div>
      </aside>

      <section className="main-content" id="overview">
        <header className="topbar">
          <div className="breadcrumb">Workspace <span>/</span> {activeWorkspace === 'token' ? 'Token & Governance' : activeWorkspace === 'revenue' ? 'Revenue Sharing' : 'Overview'}</div>
          <div className="topbar-actions">
            <span className="environment-tag">TESTNET</span>
            <button className="refresh-button" onClick={() => setRefreshKey((key) => key + 1)} disabled={chain.loading || offers.loading || revenue.loading}>
              <span className={chain.loading || offers.loading || revenue.loading ? 'spin' : ''}>↻</span> Refresh data
            </button>
          </div>
        </header>

        {activeWorkspace === 'overview' ? (
          <>
        <TransactionPanel />
        <section className="welcome-row">
          <div>
            <div className="eyebrow"><span className="eyebrow-line" /> COMPUTE FINANCE, ONCHAIN</div>
            <h1>Compute Yield <span>Dashboard</span></h1>
            <p className="welcome-copy">Discover GPU capacity, inspect protocol health, and track onchain revenue distributions from one workspace.</p>
          </div>
          <div className="hero-orb" aria-hidden="true">
            <div className="orb-ring ring-one" /><div className="orb-ring ring-two" />
            <div className="orb-core">CY<span>+</span></div>
          </div>
        </section>

        <section className="metrics-grid" aria-label="Platform status">
          <article className="metric-card">
            <div className="metric-top"><span>Network connection</span><span className="metric-icon purple">⌁</span></div>
            <div className="metric-value">{chain.loading && !chain.data ? 'Checking…' : chainConnected ? 'Connected' : 'Offline'}</div>
            <div className="metric-bottom"><StatusPill state={chain.loading && !chain.data ? 'pending' : chainConnected ? 'ok' : 'bad'} /><span>Monad Testnet</span></div>
            {chain.error && <p className="inline-error">{chain.error}</p>}
          </article>

          <article className="metric-card">
            <div className="metric-top"><span>GPU offers returned</span><span className="metric-icon blue">▦</span></div>
            <div className="metric-value">{offers.loading && !offers.data ? '…' : formatNumber(offers.data?.count ?? offerList.length)}</div>
            <div className="metric-bottom"><StatusPill state={offers.loading && !offers.data ? 'pending' : providerReady ? 'ok' : 'bad'} /><span>Vast.ai provider</span></div>
            {offers.error && <p className="inline-error">{offers.error}</p>}
          </article>

          <article className="metric-card">
            <div className="metric-top"><span>Revenue distributions</span><span className="metric-icon green">↗</span></div>
            <div className="metric-value">{revenue.loading && !revenue.data ? '…' : formatNumber(revenue.data?.distributionCount)}</div>
            <div className="metric-bottom"><StatusPill state={revenue.loading && !revenue.data ? 'pending' : revenue.data ? revenueReady ? 'ok' : 'bad' : 'bad'} /><span>Onchain contract</span></div>
            {revenue.error && <p className="inline-error">{revenue.error}</p>}
          </article>

          <article className="metric-card">
            <div className="metric-top"><span>Distribution status</span><span className="metric-icon amber">◈</span></div>
            <div className="metric-value small-value">{revenue.data?.paused === true ? 'Paused' : revenue.data?.paused === false ? 'Active' : 'Unknown'}</div>
            <div className="metric-bottom"><span className="subtle">Read directly from contract</span></div>
          </article>
        </section>

        <section className="content-grid">
          <article className="panel marketplace-panel" id="marketplace">
            <div className="panel-heading">
              <div><div className="section-kicker">CAPACITY DISCOVERY</div><h2>GPU marketplace</h2><p>{marketSource === 'live' ? 'Current offers fetched directly from the provider.' : 'Previously synchronized offers saved in PostgreSQL.'}</p></div>
              <span className="live-label"><span /> {marketSource === 'live' ? 'LIVE API' : 'SAVED DATABASE'}</span>
            </div>

            <div className="market-source-switch" role="group" aria-label="Marketplace data source">
              <button
                type="button"
                className={marketSource === 'live' ? 'source-tab active' : 'source-tab'}
                aria-pressed={marketSource === 'live'}
                onClick={() => setMarketSource('live')}
              >
                Live offers
              </button>
              <button
                type="button"
                className={marketSource === 'saved' ? 'source-tab active' : 'source-tab'}
                aria-pressed={marketSource === 'saved'}
                onClick={() => setMarketSource('saved')}
              >
                Saved offers
              </button>
              <button
                type="button"
                className="text-button"
                onClick={() => setRefreshKey((key) => key + 1)}
              >
                Refresh
              </button>
            </div>

            <div className="market-toolbar">
              <label className="search-box"><span>⌕</span><input value={search} onChange={(event) => setSearch(event.target.value)} placeholder="Search GPU models…" /></label>
              <span className="results-count">{visibleOffers.length} shown</span>
            </div>

            {selectedOffers.loading && !selectedOffers.data ? (
              <div className="empty-state"><span className="loader" /><strong>{marketSource === 'live' ? 'Loading live offers' : 'Loading saved offers'}</strong><p>{marketSource === 'live' ? 'Connecting to the provider API…' : 'Reading synchronized records from the database…'}</p></div>
            ) : selectedOffers.error ? (
              <div className="empty-state error-state"><strong>{marketSource === 'live' ? 'Live marketplace unavailable' : 'Saved marketplace unavailable'}</strong><p>{selectedOffers.error}. Check the API and try again.</p><button className="text-button" onClick={() => setRefreshKey((key) => key + 1)}>Try again</button></div>
            ) : visibleOffers.length === 0 ? (
              <div className="empty-state"><strong>{offerList.length ? 'No matching GPUs' : marketSource === 'live' ? 'No live offers returned' : 'No saved offers found'}</strong><p>{offerList.length ? 'Try a different model name.' : marketSource === 'live' ? 'The provider returned no offers. No sample offers are being substituted.' : 'Synchronize provider offers before expecting saved records here.'}</p></div>
            ) : (
              <div className="offer-list">
                {visibleOffers.map((offer, index) => {
                  const id = String(offer.id ?? offer.externalAssetId ?? index)
                  return (
                    <div className="offer-row" key={id}>
                      <div className="gpu-symbol">GPU</div>
                      <div className="gpu-details">
                        <strong>{String(offer.gpuName ?? offer.name ?? 'GPU model not provided')}</strong>
                        <span>Offer ID · {String(offer.id ?? offer.externalAssetId ?? 'Not provided')}</span>
                        {marketSource === 'saved' && (
                          <span>
                            Status: {String(offer.status ?? 'Unknown')}
                            {typeof offer.lastSeenAt === 'string'
                              ? ` · Seen ${new Date(offer.lastSeenAt).toLocaleString()}`
                              : ''}
                          </span>
                        )}
                      </div>
                      <div className="gpu-price">
                        <strong>{formatPrice(offer.hourlyPriceUsd)}</strong>
                        <span>{marketSource === 'saved' ? 'saved provider price / hr' : 'per GPU offer'}</span>
                        {typeof offer.gpuCount === 'number' && (
                          <span>{offer.gpuCount} GPU{offer.gpuCount === 1 ? '' : 's'}</span>
                        )}
                      </div>
                    </div>
                  )
                })}
              </div>
            )}
            <div className="panel-footnote"><span className="footnote-dot" /> Pricing and availability are provider-reported and may change.</div>
          </article>

          <article className="panel revenue-panel" id="revenue">
            <div className="panel-heading">
              <div><div className="section-kicker">ONCHAIN ACCOUNTING</div><h2>Revenue protocol</h2><p>Read-only contract overview.</p></div>
              <span className="contract-symbol">◇</span>
            </div>
            {revenue.loading && !revenue.data ? (
              <div className="revenue-loading"><span className="loader" /> Reading contract…</div>
            ) : revenue.error ? (
              <div className="callout callout-error"><strong>Contract status unavailable</strong><p>{revenue.error}</p></div>
            ) : revenue.data ? (
              <>
                <div className="contract-status"><span className={revenue.data.paused ? 'contract-status-dot paused' : 'contract-status-dot'} />{revenue.data.paused ? 'Contract paused' : 'Contract responding'}</div>
                <div className="detail-row"><span>Network</span><strong>Monad Testnet</strong></div>
                <div className="detail-row"><span>Chain ID</span><strong>{formatNumber(revenue.data.chainId)}</strong></div>
                <div className="detail-row"><span>Claim period</span><strong>{formatNumber(Number(revenue.data.claimPeriodSeconds) / 86400)} days</strong></div>
                <div className="detail-row"><span>Recovery delay</span><strong>{formatNumber(Number(revenue.data.recoveryDelaySeconds) / 86400)} days</strong></div>
                <div className="detail-row"><span>Treasury</span><strong className="mono">{shortAddress(revenue.data.treasury)}</strong></div>
                <a className="explorer-link" href={`https://testnet.monadexplorer.com/address/${String(revenue.data.address ?? '')}`} target="_blank" rel="noreferrer">View contract on explorer <span>↗</span></a>
              </>
            ) : <div className="empty-state"><strong>No contract data</strong><p>Contract status has not been returned by the API.</p></div>}
            <div className="security-note"><span>ⓘ</span><p>This dashboard reads public onchain data. It does not request private keys or initiate transactions.</p></div>
          </article>
        </section>

        </> 
        ) : activeWorkspace === 'token' ? (
          <section className="token-workspace" id="token-governance">
            <div className="welcome-row">
              <div>
                <div className="eyebrow"><span className="eyebrow-line" /> ONCHAIN ASSETS &amp; GOVERNANCE</div>
                <h1>Token <span>&amp; Governance</span></h1>
                <p className="welcome-copy">Connect your wallet, inspect TCYGPU, manage eligible token actions, and delegate voting power on Monad Testnet.</p>
              </div>
            </div>
            <WalletPanel />
            <div className="security-note">
              <span>ⓘ</span>
              <p>Transactions require wallet approval. Token minting is available only to authorized accounts. Testnet tokens have no mainnet value.</p>
            </div>
          </section>
        ) : (
          <RevenuePanel />
        )}
        <footer className="page-footer"><span>COMPUTE YIELD <span className="footer-separator">/</span> TESTNET PROTOTYPE</span><span>Data refreshes every 60 seconds <span className="footer-separator">·</span> <a href={`${API_BASE}/docs`} target="_blank" rel="noreferrer">API documentation ↗</a></span></footer>
      </section>
    </main>
  )
}

export default App









