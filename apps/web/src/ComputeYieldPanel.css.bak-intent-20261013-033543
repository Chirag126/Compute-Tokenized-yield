
.compute-yield {
  display: flex;
  flex-direction: column;
  gap: 22px;
  min-width: 0;
  padding-top: 30px;
}

.yield-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18px;
}

.yield-header h1 { margin-top: 13px; }

.yield-disclaimer {
  padding: 15px 17px;
  border: 1px solid #65552c;
  border-radius: 11px;
  background: rgba(215, 180, 109, .07);
  color: #c4cbd8;
  font-size: 11px;
  line-height: 1.8;
}

.yield-disclaimer strong {
  display: block;
  margin-bottom: 4px;
  color: #e8c77e;
  font-family: 'DM Mono', monospace;
  text-transform: uppercase;
}

.yield-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: start;
  gap: 17px;
}

.yield-card { min-width: 0; }

.yield-form { padding: 20px 22px; }

.yield-form > label,
.yield-input-grid label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #cdd5e4;
  font-size: 11px;
  font-weight: 600;
}

.yield-form select,
.yield-form input {
  width: 100%;
  min-width: 0;
  min-height: 43px;
  padding: 10px 11px;
  border: 1px solid #2a3949;
  border-radius: 8px;
  background: #080e15;
  color: #e9edf7;
  font: inherit;
  font-size: 12px;
}

.yield-selected {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14px;
  margin: 18px 0;
  padding: 13px;
  border: 1px solid #1e4658;
  border-radius: 10px;
  background: rgba(0, 174, 234, .055);
}

.yield-selected > div { min-width: 0; }

.yield-selected span,
.yield-selected strong,
.yield-selected small {
  display: block;
}

.yield-selected span,
.yield-selected small {
  color: #8090a5;
  font-size: 10px;
  line-height: 1.7;
}

.yield-selected strong {
  margin: 4px 0;
  color: #e5edf7;
  overflow-wrap: anywhere;
}

.yield-input-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 20px;
}

.yield-input-grid label { min-width: 0; }

.yield-results { padding: 20px 22px; }

.yield-total {
  display: flex;
  flex-direction: column;
  gap: 9px;
  padding: 20px;
  border: 1px solid #16465a;
  border-radius: 11px;
  background: #09131d;
}

.yield-total span,
.yield-total small { color: #94a5b8; font-size: 11px; }

.yield-total strong {
  color: #70e4ff;
  font: 600 clamp(27px, 3vw, 36px)/1.2 'Space Grotesk', sans-serif;
  overflow-wrap: anywhere;
}

.yield-total strong.negative { color: #ff9da5; }

.yield-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid #202838;
  color: #8b99ad;
  font-size: 11px;
}

.yield-row strong {
  color: #dce6f3;
  font: 11px 'DM Mono', monospace;
  text-align: right;
}

.yield-daily {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9px;
  margin-top: 17px;
}

.yield-daily > div {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
  padding: 12px;
  border: 1px solid #253244;
  border-radius: 9px;
  background: #0b1119;
}

.yield-daily span {
  color: #7e8da2;
  font-size: 9px;
  line-height: 1.5;
}

.yield-daily strong {
  color: #e3eaf5;
  font: 11px 'DM Mono', monospace;
  overflow-wrap: anywhere;
}

.yield-field-note {
  margin-top: 16px;
  color: #8490a5;
  font-size: 10px;
  line-height: 1.8;
}

.yield-error {
  padding: 14px;
  border: 1px solid #5a3039;
  border-radius: 9px;
  color: #ffabb3;
  font-size: 11px;
  line-height: 1.7;
}

.yield-error p { margin: 5px 0 10px; }

.yield-bottom-note { margin-top: 0; }

@media (max-width: 1100px) {
  .yield-grid { grid-template-columns: minmax(0, 1fr); }
}

@media (max-width: 600px) {
  .compute-yield { gap: 16px; padding-top: 22px; }
  .yield-form, .yield-results { padding: 16px; }
  .yield-input-grid { grid-template-columns: minmax(0, 1fr); }
  .yield-daily { grid-template-columns: minmax(0, 1fr); }
}
